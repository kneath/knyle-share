#!/usr/bin/env ruby

require "fileutils"
require "optparse"
require "rbconfig"
require "rubygems"
require "tmpdir"

options = {
  bin_dir: File.join(Dir.home, ".local", "bin"),
  executable_name: nil,
  dev: false,
  force: false,
  gem: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/install-cli [options]"

  opts.on("--bin-dir DIR", "Symlink directory (default: ~/.local/bin)") do |value|
    options[:bin_dir] = value
  end

  opts.on("--name NAME", "Symlink name (overrides default)") do |value|
    options[:executable_name] = value
  end

  opts.on("--dev", "Symlink the dev CLI (dev-knyle-share) instead of the production CLI") do
    options[:dev] = true
  end

  opts.on("--force", "Replace an existing symlink destination") do
    options[:force] = true
  end

  opts.on("--gem", "Build and install the CLI gem for the current Ruby") do
    options[:gem] = true
  end
end

parser.parse!(ARGV)

def warn_unless_on_path(directory)
  path_entries = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |entry| File.expand_path(entry) }
  warn "#{directory} is not currently on PATH." unless path_entries.include?(File.expand_path(directory))
end

if options[:gem]
  if options[:dev]
    warn "--gem cannot be combined with --dev; the development CLI is only available in symlink mode."
    exit 1
  end

  repo_root = File.expand_path("..", __dir__)
  gemspec = File.join(repo_root, "knyle-share.gemspec")
  ruby = RbConfig.ruby

  Dir.mktmpdir("knyle-share-gem") do |directory|
    built_gem = File.join(directory, "knyle-share.gem")

    unless system(ruby, "-S", "gem", "build", gemspec, "--output", built_gem, chdir: repo_root)
      warn "Failed to build the knyle-share gem."
      exit 1
    end

    unless system(ruby, "-S", "gem", "install", "--no-document", built_gem)
      warn "Failed to install the knyle-share gem."
      exit 1
    end
  end

  puts "Installed knyle-share for #{RUBY_DESCRIPTION} at #{ruby}."
  warn_unless_on_path(Gem.bindir)
  exit 0
end

source_name = options[:dev] ? "dev-knyle-share" : "knyle-share"
executable_name = options[:executable_name] || source_name

source = File.realpath(File.expand_path(source_name, __dir__))
destination = File.join(File.expand_path(options[:bin_dir]), executable_name)

if File.exist?(destination) || File.symlink?(destination)
  same_target =
    File.symlink?(destination) &&
    begin
      File.realpath(destination) == source
    rescue Errno::ENOENT
      false
    end

  if same_target
    puts "CLI already installed at #{destination}."
    exit 0
  end

  unless options[:force]
    warn "Refusing to overwrite existing #{destination}. Re-run with --force if you want to replace it."
    exit 1
  end

  FileUtils.rm_f(destination)
end

FileUtils.mkdir_p(File.dirname(destination))
FileUtils.ln_s(source, destination)

puts "Installed #{destination} -> #{source}"

warn_unless_on_path(File.dirname(destination))
