<% content_for :title, "Set Up · Knyle Share" %>

<div class="page-centered">
  <div class="centered-card wide">
    <h1>Set up Knyle Share</h1>
    <p class="lede">Verify your configuration before claiming the admin account.</p>

    <ul class="checklist">
      <% @validation_result.checks.each do |check| %>
        <li>
          <span class="check-icon <%= check.css_class %>"><%= check.icon %></span>
          <div class="check-copy">
            <div><%= check.label %></div>
            <p class="text-muted"><%= check.detail %></p>
          </div>
        </li>
      <% end %>
    </ul>

    <p class="field-note mb-2"><%= @validation_result.summary %></p>

    <div class="actions">
      <%= form_with url: admin_validate_setup_path, method: :post, data: { controller: "submit", action: "submit->submit#start" } do %>
        <button class="btn btn-secondary btn-full" type="submit" data-submit-target="button"><%= @validation_result.pending? ? "Run checks" : "Re-run checks" %></button><span role="status" data-submit-target="status"></span>
      <% end %>

      <% if @validation_result.passed? %>
        <%= button_to "Sign in with GitHub", "/auth/github", class: "btn btn-github btn-full", form: { data: { turbo: false } } %>
      <% else %>
        <span class="btn btn-github btn-full is-disabled">Sign in with GitHub</span>
      <% end %>
    </div>

    <p class="field-note mt-2"><a href="https://github.com/kneath/knyle-share#local-setup" target="_blank" rel="noreferrer">Configuration and troubleshooting instructions</a></p>
    <p class="fine-print">The first GitHub login after all checks pass will become the admin.</p>
  </div>
</div>
