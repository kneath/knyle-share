<% content_for :title, "Bundles · Knyle Share" %>
<% content_for :content_class, "is-wide" %>
<% filtered = params.slice(:q, :access, :status).values.any?(&:present?) %>
<div class="page-title">
  <h1>Bundles <span class="count"><%= @total %></span></h1>
  <%= link_to "New bundle", admin_new_bundle_path, class: "btn btn-primary" %>
</div>
<% if @cleanup_count.positive? %>
  <div class="notice-copy" role="status">
    <p>
      <%= pluralize(@cleanup_count, "file cleanup task") %> pending.<%= " Storage was unavailable; automatic retries are enabled." if @cleanup_failed %>
    </p>
    <%= button_to "Retry file cleanup", admin_retry_cleanup_path, class: "btn btn-secondary btn-small mt-1" if @cleanup_failed %>
  </div>
<% end %>
<%= form_with url: admin_bundles_path, method: :get, class: "library-filters", role: "search", data: { controller: "autosubmit" } do %>
  <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
  <input name="q" type="search" class="text-input search" value="<%= @query %>" placeholder="Filter by title or address" aria-label="Find a bundle">
  <%= select_tag :access, options_for_select([["Any access", ""], ["Protected", "protected"], ["Public", "public"]], params[:access]), class: "text-input", aria: { label: "Access" }, data: { action: "autosubmit#submit" } %>
  <%= select_tag :status, options_for_select([["Any status", ""], ["Active", "active"], ["Disabled", "disabled"]], params[:status]), class: "text-input", aria: { label: "Status" }, data: { action: "autosubmit#submit" } %>
  <button class="btn btn-secondary" type="submit">Filter</button>
<% end %>
<% if @bundles.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <%= bundle_sort_header "Name", "name" %>
        <th scope="col">Access</th>
        <%= bundle_sort_header "Views", "views", css: "num" %>
        <%= bundle_sort_header "Updated", "updated" %>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @bundles.each do |bundle| %>
        <tr class="library-row <%= 'is-disabled' if bundle.disabled? %>">
          <td>
            <a href="<%= admin_bundle_path(bundle, from: request.fullpath) %>" class="bundle-title"><%= bundle.title %></a>
            <div class="bundle-slug mono"><%= bundle.slug %> · <%= bundle.presentation_label %></div>
          </td>
          <td class="access"><%= bundle_status_tag(bundle) %></td>
          <td class="num" data-label="Views" title="<%= bundle_views_label(bundle) %>, last viewed <%= bundle_last_viewed_label(bundle).downcase %>"><%= bundle.total_views_count %></td>
          <td class="muted" title="<%= bundle.updated_at %>"><%= bundle_updated_label(bundle) %></td>
          <td class="actions">
            <% if bundle.active? %>
              <div class="row-actions" data-controller="clipboard" data-clipboard-text-value="<%= public_bundle_url_for(bundle) %>">
                <span role="status" data-clipboard-target="status"></span>
                <button class="btn btn-ghost btn-small" type="button" data-action="clipboard#copy" aria-label="Copy link to <%= bundle.title %>">Copy link</button>
                <%= link_to "Open", public_bundle_url_for(bundle), class: "btn btn-ghost btn-small", target: "_blank", rel: "noreferrer", aria: { label: "Open #{bundle.title}" } %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <h2><%= filtered ? "No matching bundles" : "Share your first file" %></h2>
    <p>Upload Markdown, images, recordings, PDFs, or a website packaged as .tar.gz. You’ll get a link to share when it’s ready.</p>
    <div class="button-row">
      <% if filtered %>
        <%= link_to "Clear filters", admin_bundles_path, class: "btn btn-secondary" %>
      <% else %>
        <%= link_to "Upload a file", admin_new_bundle_path, class: "btn btn-primary" %>
        <%= link_to "Set up the CLI", admin_api_tokens_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
<% end %>
<% if @pages > 1 %>
  <nav class="pagination" aria-label="Bundle pages">
    <span><%= link_to "Previous", admin_bundles_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-secondary btn-small" if @page > 1 %></span>
    <span>Page <%= @page %> of <%= @pages %></span>
    <span><%= link_to "Next", admin_bundles_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-secondary btn-small" if @page < @pages %></span>
  </nav>
<% end %>
