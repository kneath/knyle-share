<header class="header-bar">
  <a href="<%= admin_bundles_path %>" class="brand">Knyle Share</a>
  <nav class="header-left" aria-label="Administration">
    <%= link_to "Bundles", admin_bundles_path, aria: { current: controller_name.in?(%w[bundles uploads bundle_links]) ? "page" : nil } %>
    <%= link_to "API Tokens", admin_api_tokens_path, aria: { current: controller_name == "api_tokens" ? "page" : nil } %>
  </nav>
  <details class="account-menu">
    <summary>Account</summary>
    <div class="account-panel">
      <p class="text-muted">
        <%= installation.admin_label %>
      </p>
      <%= button_to "Sign out", admin_logout_path, class: "btn btn-secondary mt-1" %>
    </div>
  </details>
</header>
