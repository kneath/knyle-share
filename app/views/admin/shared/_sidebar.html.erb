<header class="sidebar">
  <a href="<%= admin_bundles_path %>" class="brand">Knyle Share</a>
  <nav class="sidebar-nav" aria-label="Administration">
    <%= link_to admin_bundles_path, aria: { current: controller_name.in?(%w[bundles bundle_links]) ? "page" : nil } do %>
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2.5 4.5 8 2l5.5 2.5v7L8 14l-5.5-2.5zM2.5 4.5 8 7l5.5-2.5M8 7v7"/></svg>Bundles
    <% end %>
    <%= link_to admin_new_bundle_path, aria: { current: controller_name == "uploads" ? "page" : nil } do %>
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 11V3M4.5 6.5 8 3l3.5 3.5M3 13h10"/></svg>Upload
    <% end %>
    <%= link_to admin_api_tokens_path, aria: { current: controller_name == "api_tokens" ? "page" : nil } do %>
      <svg aria-hidden="true" viewBox="0 0 16 16"><circle cx="5.5" cy="10.5" r="3"/><path d="m7.6 8.4 5.4-5.4M11 5l1.5 1.5"/></svg>API tokens
    <% end %>
  </nav>
  <div class="sidebar-account">
    <span class="sidebar-user"><%= installation.admin_label %></span>
    <%= button_to "Sign out", admin_logout_path, class: "sidebar-signout" %>
  </div>
</header>
