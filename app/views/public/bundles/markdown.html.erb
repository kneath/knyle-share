<% content_for :title, "#{@bundle.title} · Knyle Share" %>

<div class="page">
  <main>
    <div class="markdown-document" data-controller="document"><div class="reading-controls"><button class="btn btn-secondary" type="button" data-action="document#toggleFont" aria-pressed="false">Reading font</button></div>
      <article class="markdown-body">
        <%= @rendered_markdown.html_safe %>
      </article>

      <footer class="markdown-actions">
        <% unless @bundle.presentation_kind == "file_listing" %><a class="btn btn-secondary" href="<%= public_bundle_raw_url_for(@bundle, access_token: params[:access]) %>">View raw markdown</a><% end %>
        <a class="btn btn-primary" href="<%= asset_download_url %>">Download file</a>
      </footer>
    </div>
  </main>
</div>
