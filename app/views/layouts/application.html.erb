<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Knyle Share" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%# No csrf_meta_tags: generating the token writes a session cookie, and a
        Set-Cookie stops shared caches from storing public pages. The one public
        form (the password gate) carries its own token. %>
    <%= csp_meta_tag %>

    <% if @bundle&.public_access? && @bundle.active? %>
      <meta property="og:title" content="<%= @bundle.title %>">
      <meta property="og:description" content="<%= @bundle.description.presence || 'Shared with Knyle Share' %>">
      <meta property="og:type" content="website">
      <meta property="og:url" content="<%= public_bundle_url_for(@bundle) %>">
      <meta name="description" content="<%= @bundle.description.presence || 'Shared with Knyle Share' %>">
    <% else %><meta name="robots" content="noindex"><% end %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('icon.png') %>" type="image/png">
    <link rel="icon" href="<%= asset_path('icon.svg') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('icon.png') %>">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <% if controller_path == "home" || controller_path == "public/home" %>
      <%= stylesheet_link_tag "public_home", "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
