<% flash.to_hash.slice("notice", "alert").each do |type, message| %>
  <div class="flash-stack">
    <div role="<%= type == "alert" ? "alert" : "status" %>" class="flash <%= type == "alert" ? "flash-alert" : "flash-notice" %>">
      <div class="container">
        <%= message %>
      </div>
    </div>
  </div>
<% end %>
